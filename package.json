{
  "name": "mx-file-manager",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "mengx",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "vite --port 5188",
    "app": "npm run build && electron-builder --win -c.directories.output=C:/Users/mengx/AppData/Local/Temp/mx-release"
  },
  "build": {
    "appId": "com.mx.filemanager",
    "productName": "MX文件管理器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MX文件管理器",
      "artifactName": "MXFileManager-Setup-${version}.exe"
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "MXFileManager-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon-512.png"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@tanstack/react-virtual": "^3.14.10",
    "ag-psd": "^31.0.2",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.4.0",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "heic-to": "^1.5.2",
    "libarchive.js": "^2.0.2",
    "lucide-react": "^1.37.0",
    "markdown-it": "^14.3.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-filerobot-image-editor": "^5.0.0-beta.159",
    "utif": "^3.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  }
}